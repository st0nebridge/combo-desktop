{
  "name": "desk-tray",
  "version": "1.1.4",
  "description": "Run web apps seamlessly in the background with quick access from your system tray.",
  "main": "src/main.js",
  "chromeVersion": "121.0.6167.184",
  "scripts": {
    "start": "electron .",
    "whatsapp": "electron . --whatsapp",
    "facebook": "electron . --facebook",
    "profiles": "electron . --profiles list",
    "manual": "electron . --manual",
    "help": "electron . --help",
    "version": "electron . --version",
    "reset-lock": "electron . --reset-lock",
    "instances": "electron . --instances list",
    "instances:list": "electron . --instances list",
    "instances:status": "electron . --instances status",
    "instances:kill": "electron . --instances kill",
    "build": "electron-builder",
    "test": "npm run test:cli",
    "test:cli": "node tests/cli/test-runner.js",
    "test:help": "node tests/cli/modules/help-cli.test.js",
    "test:all": "node tests/run-cli-tests.js",
    "test:registry": "node tests/cli/cli-registry.test.js",
    "lint": "eslint src/",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "electron": "^29.1.1",
    "electron-builder": "^24.12.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "async-mutex": "^0.5.0",
    "commander": "^12.0.0",
    "electron-localshortcut": "^3.2.1",
    "electron-log": "^5.1.1",
    "electron-store": "^8.1.0",
    "proper-lockfile": "^4.1.2",
    "yargs": "^17.7.2"
  },
  "build": {
    "appId": "com.techdyn.desk-tray",
    "productName": "Desk Tray",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
