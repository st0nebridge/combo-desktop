{
  "name": "desk-tray",
  "version": "1.1.4",
  "description": "Run web apps seamlessly in the background with quick access from your system tray.",
  "main": "src/main.js",
  "chromeVersion": "121.0.6167.184",
  "scripts": {
    "start": "electron .",
    "whatsapp": "electron . --whatsapp",
    "facebook": "electron . --facebook",
    "profiles": "electron . --profiles list",
    "manual": "electron . --manual",
    "help": "electron . --help",
    "version": "electron . --version",
    "reset-lock": "electron . --reset-lock",
    "instances": "electron . --instances list",
    "instances:list": "electron . --instances list",
    "instances:status": "electron . --instances status",
    "instances:kill": "electron . --instances kill",
    "build": "electron-builder",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --coverage --coverageReporters=text --coverageReporters=lcov",
    "test:coverage": "jest --coverage --collectCoverageFrom=\"src/**/*.js\"",
    "test:changed": "jest --onlyChanged",
    "test:cli": "node tests/cli/test-runner.js",
    "test:help": "node tests/cli/modules/help-cli.test.js",
    "test:all": "npm run test:ci && node tests/run-cli-tests.js",
    "test:registry": "node tests/cli/cli-registry.test.js",
    "test:services": "jest tests/services --coverage",
    "test:utils": "jest tests/utils --coverage",
    "test:integration": "jest tests/integration --coverage",
    "lint": "eslint src/",
    "validate": "npm run lint && npm run test:ci",
    "verify-compliance": "node scripts/verify-compliance.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "async-mutex": "^0.5.0",
    "commander": "^12.1.0",
    "electron-localshortcut": "^3.2.1",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "proper-lockfile": "^4.1.2",
    "yargs": "^17.7.2"
  },
  "build": {
    "appId": "com.techdyn.desk-tray",
    "productName": "Desk Tray",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/main.js",
      "!src/preload.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 70,
        "functions": 85,
        "lines": 85
      },
      "src/services/**/*.js": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      },
      "src/utils/**/*.js": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/archived/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/electron-mock.js"
    ],
    "verbose": true
  }
}
